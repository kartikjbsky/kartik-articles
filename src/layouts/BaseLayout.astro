---
import "../styles/global.css";
import { site } from "../config";

const { title = site.title, description = site.description } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} — {site.name}</title>
  </head>
  <body>
    <div class="page-noise"></div>
    <header class="site-header">
      <a class="brand" href={baseUrl}>{site.name}<span>.</span></a>
      <nav>
        <a href={baseUrl}>Articles</a>
        <a href={site.portfolioUrl}>Portfolio ↗</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <span>{site.fullName}</span>
      <span>Writing, physics & ideas.</span>
    </footer>
  </body>
</html>
